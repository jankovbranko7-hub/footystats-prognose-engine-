{
  "schema_version": "1.1",
  "schema_revision": "1.1.4",
  "name": "FOOTYSTATS_IPHONE_SHORTCUT_API_SCHEMA",
  "timezone": "Europe/Vienna",
  "footystats_base_url": "https://api.football-data-api.com",
  "render_base_url": "https://footystats-prognose-engine.onrender.com",
  "primary_mode": "MANUAL_FIVE_FILE_EXPORT",
  "secret_handling": {
    "api_key": "stored only in the iOS Shortcut import parameter/variable",
    "write_to_files": false,
    "send_to_render_automatically": false,
    "include_in_saved_json": false
  },
  "selection": {
    "location": "IPHONE",
    "endpoint": "/todays-matches",
    "method": "GET",
    "query": {
      "key": "${FOOTYSTATS_API_KEY}",
      "date": "${YYYY-MM-DD}",
      "timezone": "Europe/Vienna",
      "page": "${PAGE}"
    },
    "pagination": {
      "rule": "fetch until current_page == max_page"
    },
    "user_action": "User manually selects exactly one match",
    "extract": ["id", "homeID", "awayID", "competition_id", "date_unix"]
  },
  "derived": {
    "match_id": "selected.id",
    "home_id": "selected.homeID",
    "away_id": "selected.awayID",
    "season_id": "selected.competition_id",
    "kickoff_unix": "selected.date_unix",
    "strict_max_time": "kickoff_unix - 1",
    "captured_at_unix": "Render /api/health shortcut_capture_unix at collection start"
  },
  "outputs": [
    {
      "file": "${match_id}_MatchDaten.json",
      "endpoint": "/match",
      "query": {"match_id": "${match_id}"},
      "temporal_mode": "PREMATCH_FIELD_WHITELIST"
    },
    {
      "file": "${season_id}_LeagueDaten.json",
      "endpoint": "/league-season",
      "team_endpoint": "/league-teams",
      "max_time": "${strict_max_time}",
      "include": "stats",
      "pagination": "fetch all league-team pages",
      "temporal_mode": "STRICT_MAX_TIME"
    },
    {
      "file": "${match_id}_FormDaten.json",
      "endpoint": "/lastx",
      "requests": ["home_id", "away_id"],
      "temporal_mode": "LIVE_CAPTURE_ONLY_NO_MAX_TIME"
    },
    {
      "file": "${match_id}_TableDaten.json",
      "endpoint": "/league-tables",
      "include": "stats",
      "max_time": "${strict_max_time}",
      "temporal_mode": "STRICT_MAX_TIME"
    },
    {
      "file": "${match_id}_PlayerDaten.json",
      "endpoint": "/league-players",
      "include": "stats",
      "max_time": "${strict_max_time}",
      "pagination": "fetch every page",
      "temporal_mode": "STRICT_MAX_TIME"
    }
  ],
  "iphone_storage": {
    "save_all_five_files": true,
    "target": "Shortcuts storage selected by the Shortcut",
    "stop_after_fifth_save": true,
    "automatic_render_request_after_save": false,
    "automatic_result_popup_after_save": false
  },
  "render_upload": {
    "mode": "MANUAL_USER_UPLOAD",
    "automatic_upload": false,
    "exact_file_count": 5,
    "ui": "User opens the Render V0.5.0 page, selects the five JSON files for one match, then presses V0.5.0 Analyse starten.",
    "analysis_endpoint": "/api/predict-bundle"
  },
  "validation": {
    "reject_missing_core_identifiers": true,
    "do_not_fabricate_missing_fields": true,
    "do_not_use_target_match_postmatch_fields_as_features": true,
    "historical_lastx_rule": "NOT STRICT unless capture/source timestamp proves it existed before kickoff",
    "player_pagination_complete_required": true,
    "league_team_pagination_complete_required": true,
    "probability_core_modified": false,
    "decision_engine_modified": false
  }
}
